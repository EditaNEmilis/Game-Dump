  <Item class="ScriptService">
    <Properties>
      <string name="Name">ScriptService</string>
    </Properties>
    <Item class="LocalScript">
      <Properties>
        <string name="Source">game["Players"].PlayerAdded:Connect(function(player)
    Input.KeyDown:Connect(function(key)
        if key == "R" then
            player.Health = 0
        end

        if player.Health == 0 then
            player.RespawnTime = 9999

            local respawnButton = game["PlayerGUI"]["GUI"]["Respawn"]
            respawnButton.Visible = true

            respawnButton.Clicked:Connect(function()
                wait(0.33)
                player:Respawn()
                respawnButton.Visible = false
            end)
        end
    end)
end)</string>
        <string name="Name">RagdollScript</string>
      </Properties>
    </Item>
    <Item class="ScriptInstance">
      <Properties>
        <string name="Source">game["Players"].PlayerAdded:Connect(function(player)
    player:ClearAppearance()
end)</string>
        <string name="Name">UserInit</string>
      </Properties>
    </Item>
    <Item class="ScriptInstance">
      <Properties>
        <string name="Source">local roller = game["Environment"]["Obs"]["Roller"]

local r1 = roller["Roller1"]
local r2 = roller["Roller2"]

while wait(0.1) do
    r1.Rotation = r1.Rotation + Vector3.New(5, 0, 0)
    r2.Rotation = r2.Rotation - Vector3.New(5, 0, 0)
end</string>
        <string name="Name">RollerScript</string>
      </Properties>
    </Item>
  </Item>
